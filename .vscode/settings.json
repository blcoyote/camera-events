{
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingTypeStubs": "none",
    "reportUnknownArgumentType": "none",
    "reportUnknownMemberType": "none",
    "reportUnknownVariableType": "none",
    "reportUnknownLambdaType": "none",
    "reportUnknownParameterType": "none",
    "reportUnknownReturnType": "none"
  },
  "chat.tools.terminal.autoApprove": {
    "/^python -m pytest tests/unit -q --tb=short 2>&1$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "pytest": true
  },
  "python.analysis.autoImportCompletions": true,
  "pylint.cwd": "${workspaceFolder}/api",
  "pylint.args": ["--init-hook", "import sys; sys.path.insert(0, '${workspaceFolder}/api')"],
  "python.analysis.extraPaths": ["${workspaceFolder}/api"],
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  }
}
